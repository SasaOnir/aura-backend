/// Prisma schema per Aura — backend NestJS
/// Reflects db/schema.sql (manteniamo il DDL SQL come sorgente di verità per
/// vincoli CHECK complessi e immutabilità audit_logs; Prisma viene usato
/// come client tipato per l'ORM lato applicazione).
///
/// NOTA: le migrazioni Prisma NON vengono usate in produzione; lo schema
/// viene applicato via db/schema.sql nel init-script di Postgres. Prisma
/// `migrate dev` è solo per dev locale senza Docker.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── 7.1 Identità e organizzazioni ────────────────────────────────────

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique @db.Citext
  passwordHash    String?  @map("password_hash")
  authProvider    String?  @map("auth_provider")
  authProviderId  String?  @map("auth_provider_id")
  displayName     String   @map("display_name")
  accountType     String   @map("account_type")
  status          String   @default("active")
  emailVerified   Boolean  @default(false) @map("email_verified")
  mfaSecret       String?  @map("mfa_secret")
  mfaEnabled      Boolean  @default(false) @map("mfa_enabled")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile         UserProfile?
  refreshTokens   RefreshToken[]
  userRoles       UserRole[]
  adminAccount    AdminAccount?
  notifications   Notification[]

  // Musica + AURA — relazioni inverse
  ownedArtists     Artist[]        @relation("ArtistOwner")
  artistMemberships ArtistMember[]
  playlists        Playlist[]
  follows          Follow[]
  listeningEvents  ListeningEvent[]
  credits          Credit[]
  playbackSessions PlaybackSession[]
  auraVotes        AuraVote[]
  battles          Battle[]
  collabProposals  Collaboration[]

  @@index([accountType], map: "users_account_type_idx")
  @@index([status], map: "users_status_idx")
  @@map("users")
}

model UserProfile {
  userId          String   @id @db.Uuid @map("user_id")
  avatarUrl       String?  @map("avatar_url")
  biography       String?
  country         String?
  language        String?  @default("it")
  privacySettings Json     @default("{}") @map("privacy_settings") @db.JsonB
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  userAgent   String?   @map("user_agent")
  ip          String?   @db.Inet
  issuedAt    DateTime  @default(now()) @map("issued_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedById String?  @map("replaced_by") @db.Uuid

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_idx")
  @@map("refresh_tokens")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  scope        String
  description  String?
  isProtected  Boolean  @default(false) @map("is_protected")
  createdAt    DateTime @default(now()) @map("created_at")

  permissions  RolePermission[]
  userRoles    UserRole[]
  artistMembers ArtistMember[]

  @@map("roles")
}

model Permission {
  id             String   @id @default(uuid()) @db.Uuid
  permissionKey  String   @unique @map("permission_key")
  description    String?
  category       String
  createdAt      DateTime @default(now()) @map("created_at")

  roles          RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  artistId        String?   @map("artist_id") @db.Uuid
  grantedBy       String?   @map("granted_by") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at")
  revokedAt       DateTime? @map("revoked_at")
  reason          String?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId], map: "user_roles_user_idx")
  @@map("user_roles")
}

model Organization {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  organizationType String   @map("organization_type")
  ownerUserId      String?  @map("owner_user_id") @db.Uuid
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  artists      Artist[]
  labelReleases Release[]

  @@index([ownerUserId], map: "organizations_owner_idx")
  @@map("organizations")
}

// ─── 7.8 Amministrazione ──────────────────────────────────────────────

model AdminAccount {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  status      String   @default("active")
  mfaRequired Boolean  @default(true) @map("mfa_required")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_accounts")
}

model AuditLog {
  id                    String   @id @default(uuid()) @db.Uuid
  actorId               String?  @map("actor_id") @db.Uuid
  action                String
  resourceType          String   @map("resource_type")
  resourceId            String?  @map("resource_id") @db.Uuid
  previousValueReference String? @map("previous_value_reference")
  newValueReference     String? @map("new_value_reference")
  reason                String?
  result                String   @default("success")
  ip                    String?  @db.Inet
  userAgent             String?  @map("user_agent")
  sessionId             String?  @map("session_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([actorId], map: "audit_logs_actor_idx")
  @@index([resourceType, resourceId], map: "audit_logs_resource_idx")
  @@index([action], map: "audit_logs_action_idx")
  @@index([createdAt(sort: Desc)], map: "audit_logs_created_idx")
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  data      Json      @default("{}") @db.JsonB
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_user_unread_idx")
  @@map("notifications")
}

model SystemSetting {
  id           String   @id @default(uuid()) @db.Uuid
  settingKey   String   @unique @map("setting_key")
  settingValue Json     @map("setting_value") @db.JsonB
  updatedBy    String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================================================
// MUSICA — Catalogo (tabelle già esistenti nel DB Neon)
// ============================================================================

model Artist {
  id                 String   @id @default(uuid()) @db.Uuid
  ownerUserId        String?  @map("owner_user_id") @db.Uuid
  organizationId     String?  @map("organization_id") @db.Uuid
  artistName         String   @map("artist_name")
  slug               String   @unique
  biography          String?
  imageUrl           String?  @map("image_url")
  verificationStatus String   @default("unverified") @map("verification_status")
  // Campi profilo pubblico (AURA)
  publicSlug         String?  @unique @map("public_slug")
  socialLinks        Json     @default("{}") @map("social_links") @db.JsonB
  websiteUrl         String?  @map("website_url")
  verifiedBadge      Boolean  @default(false) @map("verified_badge")
  monthlyListeners   Int      @default(0) @map("monthly_listeners")
  totalPlays         Int      @default(0) @map("total_plays")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  ownerUser      User?           @relation("ArtistOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  releases       Release[]
  members        ArtistMember[]
  follows        Follow[]
  collabA        Collaboration[] @relation("CollabA")
  collabB        Collaboration[] @relation("CollabB")

  @@index([ownerUserId], map: "artists_owner_idx")
  @@index([organizationId], map: "artists_org_idx")
  @@map("artists")
}

model ArtistMember {
  id        String @id @default(uuid()) @db.Uuid
  artistId  String @map("artist_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  roleId    String? @map("role_id") @db.Uuid

  artist    Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([artistId, userId])
  @@map("artist_members")
}

model Release {
  id           String    @id @default(uuid()) @db.Uuid
  artistId     String    @map("artist_id") @db.Uuid
  title        String
  releaseType  String    @map("release_type")
  status       String    @default("draft")
  releaseDate  DateTime? @map("release_date") @db.Date
  upc          String?
  labelId      String?   @map("label_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  artist    Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  label     Organization?  @relation(fields: [labelId], references: [id], onDelete: SetNull)
  tracks    Track[]

  @@index([artistId], map: "releases_artist_idx")
  @@index([status], map: "releases_status_idx")
  @@map("releases")
}

model Track {
  id         String   @id @default(uuid()) @db.Uuid
  releaseId  String   @map("release_id") @db.Uuid
  title      String
  version    String?
  duration   Int?
  isrc       String?
  explicit   Boolean  @default(false)
  status     String   @default("draft")
  position   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  release       Release         @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  assets        TrackAsset[]
  credits       Credit[]
  trackGenres   TrackGenre[]    @relation("TrackGenres")
  listening     ListeningEvent[]
  playlistItems PlaylistTrack[]
  auraVotes     AuraVote[]
  battleParticipants BattleParticipant[]
  battles       Battle[]        @relation("BattleWinner")

  @@index([releaseId], map: "tracks_release_idx")
  @@map("tracks")
}

model TrackAsset {
  id               String   @id @default(uuid()) @db.Uuid
  trackId           String   @map("track_id") @db.Uuid
  assetType         String   @map("asset_type")
  storageKey        String   @map("storage_key")
  format            String?
  checksum          String?
  processingStatus String   @default("pending") @map("processing_status")
  createdAt         DateTime @default(now()) @map("created_at")

  track  Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId], map: "track_assets_track_idx")
  @@map("track_assets")
}

model Credit {
  id              String   @id @default(uuid()) @db.Uuid
  trackId          String   @map("track_id") @db.Uuid
  contributorName  String   @map("contributor_name")
  contributorRole String   @map("contributor_role")
  contributorId    String?  @map("contributor_id") @db.Uuid
  percentage       Decimal? @db.Decimal(5, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  track  Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user   User? @relation(fields: [contributorId], references: [id], onDelete: SetNull)

  @@index([trackId], map: "credits_track_idx")
  @@map("credits")
}

model Genre {
  id       String   @id @default(uuid()) @db.Uuid
  name     String   @unique
  parentId String?  @map("parent_id") @db.Uuid
  parent   Genre?  @relation("GenreTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Genre[] @relation("GenreTree")
  trackGenres TrackGenre[] @relation("TrackGenres")

  @@map("genres")
}

model TrackGenre {
  trackId String @map("track_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid
  track   Track  @relation("TrackGenres", fields: [trackId], references: [id], onDelete: Cascade)
  genre   Genre  @relation("TrackGenres", fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([trackId, genreId])
  @@map("track_genres")
}

model Playlist {
  id           String    @id @default(uuid()) @db.Uuid
  ownerUserId  String?   @map("owner_user_id") @db.Uuid
  title        String
  visibility   String    @default("private")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  owner  User?           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  items  PlaylistTrack[]
  streamingConnection StreamingConnection?

  @@map("playlists")
}

model PlaylistTrack {
  playlistId String   @map("playlist_id") @db.Uuid
  trackId    String   @map("track_id") @db.Uuid
  position   Int
  addedAt    DateTime @default(now()) @map("added_at")

  playlist  Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@map("playlist_tracks")
}

model Follow {
  followerUserId String   @map("follower_user_id") @db.Uuid
  artistId       String   @map("artist_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  follower User   @relation(fields: [followerUserId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([followerUserId, artistId])
  @@index([artistId], map: "follows_artist_idx")
  @@map("follows")
}

model ListeningEvent {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String?    @map("user_id") @db.Uuid
  trackId           String     @map("track_id") @db.Uuid
  startedAt         DateTime   @map("started_at")
  endedAt           DateTime?  @map("ended_at")
  qualifiedDuration Int?       @map("qualified_duration")
  source            String?
  eventType         String?    @map("event_type")
  createdAt         DateTime   @default(now()) @map("created_at")

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  track   Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId], map: "listening_events_track_idx")
  @@index([trackId, userId], map: "listening_events_user_idx")
  @@map("listening_events")
}

model PlaybackSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  startedAt  DateTime  @map("started_at")
  endedAt    DateTime? @map("ended_at")
  deviceType String?   @map("device_type")

  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("playback_sessions")
}

// ============================================================================
// AURA SYSTEM — Vote, Battles, Streaming, Collaborations
// ============================================================================

model AuraVote {
  id                String   @id @default(uuid()) @db.Uuid
  trackId           String   @map("track_id") @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  battleId          String?  @map("battle_id") @db.Uuid
  voterFingerprint  String?  @map("voter_fingerprint")
  auraValue         Int      @default(1) @map("aura_value")
  createdAt         DateTime @default(now()) @map("created_at")

  track   Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  battle  Battle?  @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@index([trackId], map: "aura_votes_track_idx")
  @@index([battleId], map: "aura_votes_battle_idx")
  @@map("aura_votes")
}

model Battle {
  id             String     @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  battleType     String     @default("tracks") @map("battle_type")
  duration       String     @default("24h")     // 24h | 3d | 7d
  status         String     @default("upcoming") // upcoming | active | voting | closed | cancelled
  startAt        DateTime   @default(now()) @map("start_at")
  endAt          DateTime   @map("end_at")
  winnerTrackId  String?    @map("winner_track_id") @db.Uuid
  createdBy       String?    @map("created_by") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  winnerTrack  Track?              @relation("BattleWinner", fields: [winnerTrackId], references: [id], onDelete: SetNull)
  creator     User?                @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  participants BattleParticipant[]
  votes       AuraVote[]

  @@index([status], map: "battles_status_idx")
  @@index([endAt], map: "battles_end_idx")
  @@map("battles")
}

model BattleParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  battleId  String   @map("battle_id") @db.Uuid
  trackId   String   @map("track_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")

  battle  Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  track    Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([battleId, trackId])
  @@index([battleId], map: "bp_battle_idx")
  @@index([trackId], map: "bp_track_idx")
  @@map("battle_participants")
}

model StreamingConnection {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  platform      String
  status        String    @default("active")
  config        Json      @default("{}") @db.JsonB
  connectedPlaylistId String?  @unique @map("connected_playlist_id") @db.Uuid
  lastSyncAt    DateTime? @map("last_sync_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  playlist Playlist? @relation(fields: [connectedPlaylistId], references: [id], onDelete: SetNull)

  @@map("streaming_connections")
}

model Collaboration {
  id          String   @id @default(uuid()) @db.Uuid
  artistAId   String   @map("artist_a_id") @db.Uuid
  artistBId   String   @map("artist_b_id") @db.Uuid
  status      String   @default("pending")  // pending | accepted | rejected | completed
  proposedBy  String?  @map("proposed_by") @db.Uuid
  trackId     String?  @map("track_id") @db.Uuid
  message     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  artistA   Artist @relation("CollabA", fields: [artistAId], references: [id], onDelete: Cascade)
  artistB   Artist @relation("CollabB", fields: [artistBId], references: [id], onDelete: Cascade)
  proposer  User?  @relation(fields: [proposedBy], references: [id], onDelete: SetNull)

  @@index([artistAId], map: "collab_a_idx")
  @@index([artistBId], map: "collab_b_idx")
  @@map("collaborations")
}
