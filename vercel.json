{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "public": true,
  "framework": null,
  "builds": [
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "src/**/*,prisma/schema.prisma",
        "installCommand": "npm ci --include=optional --no-audit --no-fund",
        "buildCommand": "npx prisma generate --schema=prisma/schema.prisma && npm run build"
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next",
      "config": {
        "installCommand": "npm ci",
        "buildCommand": "npm run build",
        "outputDirectory": ".next"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/index.ts" },
    { "src": "/auth/(.*)", "dest": "/backend/api/index.ts" },
    { "src": "/users(.*)", "dest": "/backend/api/index.ts" },
    { "src": "/roles(.*)", "dest": "/backend/api/index.ts" },
    { "src": "/staff(.*)", "dest": "/backend/api/index.ts" },
    { "src": "/audit(.*)", "dest": "/backend/api/index.ts" },
    { "src": "/admin/(.*)", "dest": "/backend/api/index.ts" },
    { "src": "/health", "dest": "/backend/api/index.ts" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
