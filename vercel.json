{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    {
      "src": "backend/src/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "src/**/*,prisma/schema.prisma",
        "installCommand": "cd ../../ && npm ci --include=optional --no-audit --no-fund",
        "buildCommand": "cd ../../ && npx prisma generate --schema=backend/prisma/schema.prisma"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/src/api/index.ts" },
    { "src": "/auth/(.*)", "dest": "/backend/src/api/index.ts" },
    { "src": "/users(.*)", "dest": "/backend/src/api/index.ts" },
    { "src": "/roles(.*)", "dest": "/backend/src/api/index.ts" },
    { "src": "/staff(.*)", "dest": "/backend/src/api/index.ts" },
    { "src": "/audit(.*)", "dest": "/backend/src/api/index.ts" },
    { "src": "/admin/(.*)", "dest": "/backend/src/api/index.ts" },
    { "src": "/health", "dest": "/backend/src/api/index.ts" },
    { "src": "/(.*)", "dest": "/backend/src/api/index.ts" }
  ]
}
