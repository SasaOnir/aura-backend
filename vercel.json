{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [
    {
      "src": "backend/src/api/health.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "src/**/*",
        "installCommand": "npm ci --include=optional --no-audit --no-fund"
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next",
      "config": {
        "installCommand": "npm ci",
        "buildCommand": "npm run build",
        "outputDirectory": ".next"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/src/api/health.ts"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/backend/src/api/health.ts"
    },
    {
      "src": "/users(.*)",
      "dest": "/backend/src/api/health.ts"
    },
    {
      "src": "/roles(.*)",
      "dest": "/backend/src/api/health.ts"
    },
    {
      "src": "/staff(.*)",
      "dest": "/backend/src/api/health.ts"
    },
    {
      "src": "/audit(.*)",
      "dest": "/backend/src/api/health.ts"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/backend/src/api/health.ts"
    },
    {
      "src": "/health",
      "dest": "/backend/src/api/health.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}