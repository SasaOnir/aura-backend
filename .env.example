# AURA — variabili d'ambiente (copia in .env e personalizza)
# Non committare MAI il file .env reale. Questo è un template.

# ─── Database ────────────────────────────────────────────────────────────
POSTGRES_USER=aura
POSTGRES_PASSWORD=cambiami_in_produzione
POSTGRES_DB=aura
# Usato dal backend (Prisma / pg)
DATABASE_URL=postgresql://aura:cambiami_in_produzione@localhost:5432/aura?schema=public

# ─── Redis (cache + rate-limit + code BullMQ) ────────────────────────────
REDIS_PASSWORD=cambiami_in_produzione
REDIS_URL=redis://:cambiami_in_produzione@localhost:6379

# ─── JWT / Auth ──────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 64   (due valori DIVERSI, almeno 48 caratteri in produzione)
JWT_ACCESS_SECRET=cambiami_con_chiave_random_lunga_almeno_64_byte_xxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=cambiami_con_altra_chiave_random_lunga_almeno_64_byte_yyyyyyyyyyyyyy
JWT_ACCESS_TTL=900          # 15 minuti (secondi)
JWT_REFRESH_TTL=2592000     # 30 giorni

# ─── Bootstrap Super Admin (primo avvio) ────────────────────────────────
# Compila solo al primo avvio; poi puoi rimuoverle. Il backend le legge,
# crea il Super Admin, poi ignora queste env ai riavvii successivi.
AURA_SUPERADMIN_EMAIL=owner@aura.example
AURA_SUPERADMIN_PASSWORD=cambiami_password_forte_almeno_16_caratteri
AURA_SUPERADMIN_NAME=Proprietario Aura

# ─── Backend ────────────────────────────────────────────────────────────
PORT=4000
# In 'production' l'app RIFIUTA di partire con segreti di esempio/deboli (src/config/env.validation.ts).
NODE_ENV=development
# Quanti reverse proxy ci sono davanti (Render/Cloudflare = 1). 0 = nessuno. Serve per l'IP reale (rate limit, audit).
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:3000

# ─── Object storage audio (S3-compatible; in dev si può usare MinIO) ────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aura-audio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=cambiami_in_produzione
S3_FORCE_PATH_STYLE=true

# ─── Email (Resend, opzionale — per OTP recupero password) ──────────────
# Lascia vuoto per disabilitare; il backend usa modalità demo (codice finto).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ─── Frontend (Next.js) ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
